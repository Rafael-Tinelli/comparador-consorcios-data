{
  "version": "2.1.0",
  "purpose": "triagem e comparação de administradoras por sinais públicos verificáveis",
  "general_score": {
    "enabled": false,
    "reason": "A V2 não redistribui pesos entre evidências ausentes e não transforma porte/presença em qualidade."
  },
  "identity": {
    "primary_key": "cnpj_root_8_digits",
    "current_registry_required": true,
    "name_fallback_for_join": false
  },
  "monthly_operations": {
    "canonical_member": "Segmentos_Consolidados",
    "key": [
      "cnpj_root",
      "competencia",
      "segmento_codigo"
    ],
    "latest_competence_only": true,
    "group_files_role": [
      "prazo_medio_grupos",
      "valor_medio_bem_grupos",
      "reconciliacao"
    ],
    "group_files_must_not_be_summed_into_consolidated": true,
    "delinquency_share_formula": "inadimplentes/(cotas_ativas_em_dia+inadimplentes)"
  },
  "complaints": {
    "preserve_official_index": true,
    "invent_position_from_row_order": false,
    "non_disclosed_index": "null_with_reason",
    "total_complaints_is_not_index_numerator": true
  },
  "presence": {
    "role": "informational",
    "affects_quality_assessment": false
  },
  "commercial_offers": {
    "separate_contract": true,
    "affects_assessment": false
  },
  "missingness": {
    "zero_is_missing": false,
    "missing_is_zero": false,
    "redistribute_weights": false,
    "neutral_score_for_missing": false
  },
  "relative_interpretation": {
    "enabled": true,
    "contract": "interpretacao-relativa.v1",
    "general_ranking": false,
    "comparison_unit": "mesmo_segmento_e_mesma_competencia",
    "segment_metrics": [
      "taxa_administracao_pct",
      "cotas_ativas_em_dia",
      "contemplacoes_mes",
      "inadimplencia_participacao"
    ],
    "complaints_scope": "administradoras_do_cadastro_atual_com_indice_bcb_divulgado",
    "reference_statistics": [
      "min",
      "q1",
      "mediana",
      "q3",
      "max"
    ],
    "quartile_method": "interpolacao_linear_sobre_posicao_p_vezes_n_menos_1",
    "criterion_order": {
      "allowed": true,
      "ties": "dense_rank",
      "official_position": false,
      "general_quality_ranking": false
    },
    "language_policy": {
      "relative_observation_only": true,
      "porte_is_quality": false,
      "missing_is_favorable": false,
      "quartile_highlight_only": true
    },
    "contemplation_policy": {
      "absolute_count_is_allowed": true,
      "infer_individual_probability": false,
      "infer_time_to_contemplation": false,
      "claim_fastest_administrator": false
    },
    "trust_reading": {
      "purpose": "responder com grau de evidência, sinais disponíveis e limites, sem certificar confiabilidade universal",
      "signals": [
        "cadastro_atual_bcb",
        "operacao_mensal_observada",
        "registro_reclamacoes_vinculado",
        "indice_reclamacoes_bcb_divulgado"
      ]
    }
  }
}
